<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="add-biorepository-qc-round-last-updated" author="openelis-biorepository">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="biorepository_qc_round" schemaName="clinlims"/>
            <not>
                <columnExists tableName="biorepository_qc_round" schemaName="clinlims" columnName="last_updated"/>
            </not>
        </preConditions>
        <addColumn tableName="biorepository_qc_round" schemaName="clinlims">
            <column name="last_updated" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet id="add-biorepository-qc-round-sample-last-updated" author="openelis-biorepository">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="biorepository_qc_round_sample" schemaName="clinlims"/>
            <not>
                <columnExists tableName="biorepository_qc_round_sample" schemaName="clinlims" columnName="last_updated"/>
            </not>
        </preConditions>
        <addColumn tableName="biorepository_qc_round_sample" schemaName="clinlims">
            <column name="last_updated" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>
</databaseChangeLog>
