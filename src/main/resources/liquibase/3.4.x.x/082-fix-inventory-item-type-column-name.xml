<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <!-- Fix inventory_item_type.lastupdated -> last_updated to match BaseObject mapping -->
    <changeSet id="082-fix-inventory-item-type-column-name" author="kiro">
        <renameColumn tableName="inventory_item_type"
                      oldColumnName="lastupdated"
                      newColumnName="last_updated"
                      columnDataType="TIMESTAMP"/>
        <rollback>
            <renameColumn tableName="inventory_item_type"
                          oldColumnName="last_updated"
                          newColumnName="lastupdated"
                          columnDataType="TIMESTAMP"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
